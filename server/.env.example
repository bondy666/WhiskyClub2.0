# Server
PORT=4000

# Azure SQL (whiskyclubdb). Leave blank to run on the built-in seeded in-memory store.
# Option A: full connection string
# SQL_CONNECTION_STRING=Server=tcp:yourserver.database.windows.net,1433;Database=whiskyclubdb;...

# Option B: individual settings
# SQL_SERVER=yourserver.database.windows.net
# SQL_DATABASE=whiskyclubdb
# SQL_USER=appuser
# SQL_PASSWORD=your-password
# SQL_ENCRYPT=true

# When true, /.auth/me returns a mock member so the app is usable in local dev.
DEV_AUTH=true
